# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# --- Supabase ---------------------------------------------------------
# Project Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service-role key — server-only, never exposed to the browser. Used for
# inviting board members and for the seed script.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Resend -------------------------------------------------------------
# resend.com → API Keys. For local dev you can leave RESEND_FROM_EMAIL unset
# to send from Resend's shared onboarding@resend.dev sandbox address.
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL="Bid Ledger <onboarding@resend.dev>"

# --- App ------------------------------------------------------------------
# Used to build check-in links in emails and Supabase auth redirects.
# Set to your real deployed URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
